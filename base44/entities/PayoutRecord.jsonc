{
  "name": "PayoutRecord",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string"
    },
    "gross_amount": {
      "type": "number"
    },
    "platform_fee": {
      "type": "number"
    },
    "creator_amount": {
      "type": "number"
    },
    "stripe_payout_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending"
    },
    "period": {
      "type": "string"
    },
    "stream_count": {
      "type": "number",
      "default": 0
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "creator_id",
    "gross_amount",
    "platform_fee",
    "creator_amount"
  ]
}