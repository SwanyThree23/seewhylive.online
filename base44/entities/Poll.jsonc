{
  "name": "Poll",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "Associated room ID"
    },
    "host_id": {
      "type": "string",
      "description": "Host who created the poll"
    },
    "question": {
      "type": "string",
      "description": "Poll question",
      "maxLength": 200
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Poll answer options"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active",
      "description": "Poll status"
    },
    "timeout_seconds": {
      "type": "number",
      "description": "Poll duration in seconds (null = no timeout)",
      "default": null
    },
    "allow_re_vote": {
      "type": "boolean",
      "default": false,
      "description": "Allow users to change their vote"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Poll creation timestamp"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Poll expiration time"
    }
  },
  "required": [
    "room_id",
    "host_id",
    "question",
    "options"
  ]
}