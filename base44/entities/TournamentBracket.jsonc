{
  "name": "TournamentBracket",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "default": "7 Rock / 5-150 / Double Elimination"
    },
    "venue": {
      "type": "string",
      "default": "Jamar's Sports Bar & Grill, Des Moines, WA"
    },
    "year": {
      "type": "number"
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "winner_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "completed"
      ],
      "default": "upcoming"
    },
    "peak_viewers": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "year"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}