{
  "name": "UserPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preferred categories"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preferred tags"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "onboarding_step": {
      "type": "number",
      "default": 0
    },
    "preferred_language": {
      "type": "string",
      "default": "en"
    },
    "notification_preferences": {
      "type": "object",
      "description": "Notification settings"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}