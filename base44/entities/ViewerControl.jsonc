{
  "name": "ViewerControl",
  "properties": {
    "hand_raised": {
      "default": false,
      "type": "boolean"
    },
    "hand_raised_at": {
      "format": "date-time",
      "type": "string"
    },
    "is_fullscreen": {
      "default": false,
      "type": "boolean"
    },
    "is_pip": {
      "default": false,
      "description": "Picture-in-picture mode",
      "type": "boolean"
    },
    "quality_preference": {
      "default": "auto",
      "enum": [
        "auto",
        "1080p",
        "720p",
        "480p",
        "360p"
      ],
      "type": "string"
    },
    "room_id": {
      "description": "Room context",
      "type": "string"
    },
    "subtitles_enabled": {
      "default": false,
      "type": "boolean"
    },
    "user_id": {
      "description": "Viewer user ID",
      "type": "string"
    },
    "volume": {
      "default": 80,
      "description": "Volume 0-100",
      "type": "number"
    }
  },
  "required": [
    "user_id",
    "room_id"
  ],
  "type": "object",
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}