{
  "name": "RTCSignal",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "Room this signal belongs to"
    },
    "from_peer": {
      "type": "string",
      "description": "Cryptographically-secure sender peer ID"
    },
    "to_peer": {
      "type": "string",
      "description": "Target peer ID — null = broadcast to all peers in room"
    },
    "user_id": {
      "type": "string",
      "description": "User who sent this signal"
    },
    "signal_type": {
      "type": "string",
      "enum": ["peer_join", "offer", "answer", "ice", "peer_left"],
      "description": "WebRTC signal type"
    },
    "sdp": {
      "type": "object",
      "description": "RTCSessionDescription payload (offer / answer)"
    },
    "candidate": {
      "type": "object",
      "description": "RTCIceCandidate payload"
    }
  },
  "required": ["room_id", "from_peer", "signal_type"],
  "rls": {
    "create": {
      "user_condition": {
        "role": { "$exists": true }
      }
    },
    "read": {
      "user_condition": {
        "role": { "$exists": true }
      }
    }
  }
}
