{
  "name": "GuardianLog",
  "type": "object",
  "properties": {
    "stream_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "toxicity_score": {
      "type": "number"
    },
    "action": {
      "type": "string",
      "enum": [
        "flagged",
        "warned",
        "banned",
        "none"
      ],
      "default": "none"
    },
    "reversed_by": {
      "type": "string"
    },
    "reversed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "message",
    "toxicity_score",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.stream_id": {
            "$in": [
              "{{user.rooms_as_host}}"
            ]
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}