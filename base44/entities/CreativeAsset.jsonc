{
  "name": "CreativeAsset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name (defaults to file name)"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded file URL"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image",
      "description": "Kind of asset"
    },
    "category": {
      "type": "string",
      "default": "general",
      "description": "User-assigned category tag (product, b-roll, logo, thumbnail\u2026)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Free-form tags"
    }
  },
  "required": [
    "file_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}