{
  "name": "DeletionRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who asked to leave"
    },
    "user_email": {
      "type": "string",
      "description": "Email snapshot so the request can be actioned"
    },
    "user_name": {
      "type": "string",
      "description": "Display name snapshot"
    },
    "reason": {
      "type": "string",
      "description": "Why the user is leaving"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "reason"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}