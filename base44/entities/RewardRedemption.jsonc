{
  "name": "RewardRedemption",
  "type": "object",
  "properties": {
    "reward_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "creator_id": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "reward_name": {
      "type": "string"
    },
    "reward_type": {
      "type": "string"
    },
    "reward_value": {
      "type": "string"
    },
    "points_spent": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "fulfilled",
        "rejected"
      ],
      "default": "pending"
    },
    "message": {
      "type": "string",
      "description": "Optional message from viewer (e.g. song to request)"
    },
    "fulfilled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "reward_id",
    "user_id",
    "creator_id",
    "reward_name",
    "points_spent"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}