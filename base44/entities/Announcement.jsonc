{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string",
      "description": "Community ID"
    },
    "title": {
      "type": "string",
      "description": "Announcement title"
    },
    "content": {
      "type": "string",
      "description": "Announcement content"
    },
    "created_by": {
      "type": "string",
      "description": "Admin who created"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal",
      "description": "Priority level"
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "all",
        "admins",
        "moderators",
        "subscribers",
        "new_members"
      ],
      "default": "all",
      "description": "Target audience"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Pin to top"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled send time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Actual send time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sent"
      ],
      "default": "draft",
      "description": "Announcement status"
    }
  },
  "required": [
    "community_id",
    "title",
    "content",
    "created_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.community_id": {
            "$in": [
              "{{user.communities_as_admin}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.community_id": {
            "$in": [
              "{{user.communities_as_member}}"
            ]
          }
        },
        {
          "data.target_audience": "all"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "data.community_id": {
            "$in": [
              "{{user.communities_as_admin}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "data.community_id": {
            "$in": [
              "{{user.communities_as_admin}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}