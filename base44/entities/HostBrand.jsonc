{
  "properties": {
    "brand_color": {
      "default": "#C9A84C",
      "title": "Brand Color",
      "type": "string"
    },
    "creator_id": {
      "title": "Creator ID",
      "type": "string"
    },
    "logo_emoji": {
      "default": "\ud83c\udfb2",
      "title": "Logo Emoji",
      "type": "string"
    },
    "overlay_style": {
      "enum": [
        "none",
        "grid",
        "dots",
        "scanlines"
      ],
      "title": "Overlay Style",
      "type": "string"
    },
    "stream_name": {
      "title": "Stream Name",
      "type": "string"
    },
    "tagline": {
      "title": "Tagline",
      "type": "string"
    },
    "theme": {
      "title": "Theme",
      "type": "string"
    }
  },
  "required": [
    "creator_id",
    "stream_name"
  ],
  "type": "object",
  "name": "HostBrand",
  "rls": {
    "create": {
      "data.creator_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}