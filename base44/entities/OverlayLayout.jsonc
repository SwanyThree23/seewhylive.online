{
  "name": "OverlayLayout",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "preset_used": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "creator_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.creator_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}