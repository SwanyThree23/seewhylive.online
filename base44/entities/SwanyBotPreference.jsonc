{
  "name": "SwanyBotPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID"
    },
    "preference_type": {
      "type": "string",
      "enum": [
        "interest",
        "language",
        "notification_style",
        "favorite_topic",
        "stream_category"
      ],
      "description": "Type of preference"
    },
    "preference_value": {
      "type": "string",
      "description": "Preference value"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "preference_type",
    "preference_value"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}