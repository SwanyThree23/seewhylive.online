{
  "name": "Discussion",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string",
      "description": "Associated community"
    },
    "user_id": {
      "type": "string",
      "description": "Post author"
    },
    "user_name": {
      "type": "string",
      "description": "Author name"
    },
    "user_avatar": {
      "type": "string",
      "description": "Author avatar"
    },
    "content": {
      "type": "string",
      "description": "Discussion content"
    },
    "title": {
      "type": "string",
      "description": "Discussion title (optional)"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Image URLs"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "Number of likes"
    },
    "replies_count": {
      "type": "number",
      "default": 0,
      "description": "Number of replies"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent discussion ID for replies"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Pinned to top"
    }
  },
  "required": [
    "community_id",
    "user_id",
    "content"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.community_id": {
            "$in": [
              "{{user.communities_as_member}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.community_id": {
            "$in": [
              "{{user.communities_as_admin}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.community_id": {
            "$in": [
              "{{user.communities_as_admin}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}