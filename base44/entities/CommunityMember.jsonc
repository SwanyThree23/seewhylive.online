{
  "name": "CommunityMember",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string",
      "description": "Community ID"
    },
    "user_id": {
      "type": "string",
      "description": "User ID"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "moderator",
        "member"
      ],
      "default": "member",
      "description": "Member role"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time",
      "description": "Join date"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Active membership"
    }
  },
  "required": [
    "community_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.community_id": {
            "$in": [
              "{{user.communities_as_admin}}"
            ]
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.community_id": {
            "$in": [
              "{{user.communities_as_member}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.community_id": {
            "$in": [
              "{{user.communities_as_admin}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.community_id": {
            "$in": [
              "{{user.communities_as_admin}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}