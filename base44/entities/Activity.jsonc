{
  "name": "Activity",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who performed the activity"
    },
    "type": {
      "type": "string",
      "enum": [
        "room_created",
        "room_joined",
        "community_joined",
        "subscription",
        "tip_sent",
        "challenge_completed",
        "badge_earned"
      ],
      "description": "Activity type"
    },
    "title": {
      "type": "string",
      "description": "Activity title"
    },
    "description": {
      "type": "string",
      "description": "Activity description"
    },
    "entity_id": {
      "type": "string",
      "description": "Related entity ID"
    },
    "entity_type": {
      "type": "string",
      "description": "Related entity type"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "Visible to others"
    }
  },
  "required": [
    "user_id",
    "type",
    "title"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.is_public": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}