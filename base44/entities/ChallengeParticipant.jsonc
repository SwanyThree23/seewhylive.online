{
  "name": "ChallengeParticipant",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string",
      "description": "Challenge ID"
    },
    "user_id": {
      "type": "string",
      "description": "Participant user ID"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "Current progress"
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "Score or points"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "Challenge completed"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Completion timestamp"
    },
    "rank": {
      "type": "number",
      "description": "Leaderboard rank"
    }
  },
  "required": [
    "challenge_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}