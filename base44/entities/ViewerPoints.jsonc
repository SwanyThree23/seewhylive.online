{
  "name": "ViewerPoints",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "points": {
      "type": "number",
      "default": 0
    },
    "watch_minutes": {
      "type": "number",
      "default": 0
    },
    "tips_sent_count": {
      "type": "number",
      "default": 0
    },
    "messages_sent_count": {
      "type": "number",
      "default": 0
    },
    "reactions_sent_count": {
      "type": "number",
      "default": 0
    },
    "clips_created_count": {
      "type": "number",
      "default": 0
    },
    "subscribed": {
      "type": "boolean",
      "default": false
    },
    "last_active": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "room_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}