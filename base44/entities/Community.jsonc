{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Community name"
    },
    "description": {
      "type": "string",
      "description": "Community description"
    },
    "avatar_url": {
      "type": "string",
      "description": "Community avatar"
    },
    "cover_url": {
      "type": "string",
      "description": "Community cover image"
    },
    "category": {
      "type": "string",
      "enum": [
        "music",
        "gaming",
        "tech",
        "education",
        "business",
        "entertainment",
        "sports",
        "lifestyle",
        "other"
      ],
      "default": "other",
      "description": "Community category"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "Public or private"
    },
    "member_count": {
      "type": "number",
      "default": 0,
      "description": "Total members"
    },
    "owner_id": {
      "type": "string",
      "description": "Community owner"
    },
    "rules": {
      "type": "string",
      "description": "Community rules"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Community tags"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Verified community"
    }
  },
  "required": [
    "name",
    "owner_id"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "data.community_id": {
            "$in": [
              "{{user.communities_as_member}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}