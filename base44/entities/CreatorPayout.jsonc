{
  "name": "CreatorPayout",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string",
      "description": "Creator user ID"
    },
    "pending_balance": {
      "type": "number",
      "default": 0,
      "description": "Amount pending withdrawal"
    },
    "total_earned": {
      "type": "number",
      "default": 0,
      "description": "Total all-time earnings"
    },
    "total_platform_cut": {
      "type": "number",
      "default": 0,
      "description": "Total platform cuts taken (10%)"
    },
    "last_payout_date": {
      "type": "string",
      "format": "date-time",
      "description": "Last withdrawal timestamp"
    },
    "payout_method": {
      "type": "string",
      "enum": [
        "paypal",
        "cashapp",
        "venmo",
        "zelle",
        "chime",
        "bank_transfer"
      ],
      "description": "Preferred payout method"
    }
  },
  "required": [
    "creator_id"
  ]
}