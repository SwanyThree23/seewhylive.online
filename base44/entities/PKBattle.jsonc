{
  "name": "PKBattle",
  "type": "object",
  "properties": {
    "challenger_id": {
      "type": "string"
    },
    "challenger_name": {
      "type": "string"
    },
    "opponent_id": {
      "type": "string"
    },
    "opponent_name": {
      "type": "string"
    },
    "format": {
      "type": "number",
      "enum": [
        3,
        5,
        7,
        10
      ],
      "default": 5
    },
    "score_a": {
      "type": "number",
      "default": 0
    },
    "score_b": {
      "type": "number",
      "default": 0
    },
    "winner_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "ended",
        "forfeited"
      ],
      "default": "pending"
    },
    "match_log": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "challenger_id",
    "challenger_name",
    "format"
  ],
  "rls": {
    "create": {
      "data.challenger_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.challenger_id": "{{user.id}}"
        },
        {
          "data.opponent_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.challenger_id": "{{user.id}}"
        },
        {
          "data.opponent_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}