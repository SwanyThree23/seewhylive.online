{
  "name": "WatchParty",
  "type": "object",
  "properties": {
    "host_id": {
      "type": "string"
    },
    "party_code": {
      "type": "string"
    },
    "stream_id": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended"
      ],
      "default": "active"
    },
    "settings": {
      "type": "object"
    }
  },
  "required": [
    "host_id",
    "party_code"
  ],
  "rls": {
    "create": {
      "data.host_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.host_id": "{{user.id}}"
        },
        {
          "data.is_public": true
        },
        {
          "_id": {
            "$in": [
              "{{user.watch_parties_as_member}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.host_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": null
  }
}