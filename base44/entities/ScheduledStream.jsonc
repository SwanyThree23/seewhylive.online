{
  "name": "ScheduledStream",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "thumbnail_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "gaming",
        "music",
        "education",
        "talk",
        "fitness",
        "cooking",
        "art",
        "tech",
        "irl",
        "other"
      ],
      "default": "other"
    },
    "scheduled_start": {
      "type": "string",
      "format": "date-time"
    },
    "estimated_duration_minutes": {
      "type": "number",
      "default": 60
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "biweekly"
      ]
    },
    "rtmp_destinations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "reminder_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "room_id": {
      "type": "string"
    }
  },
  "required": [
    "creator_id",
    "title",
    "scheduled_start"
  ],
  "rls": {
    "create": {
      "data.creator_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "data.is_public": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}