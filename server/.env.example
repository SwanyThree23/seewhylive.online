# SeeWhy LIVE — server environment variables
# Copy to .env and fill in real values before starting the server.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=/opt/seewhy/data/seewhy.db

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── CORS / frontend ──────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://seewhylive.online

# ── mediasoup SFU ────────────────────────────────────────────────────────────
# The public IP address of this VPS, announced to WebRTC clients.
# Defaults to 2.24.194.112 if not set.
MEDIASOUP_ANNOUNCED_IP=2.24.194.112

# ── TURN server ──────────────────────────────────────────────────────────────
# Secret used to generate HMAC-SHA256 TURN credentials (5-min TTL).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURN_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── ZEGOCLOUD SFU ────────────────────────────────────────────────────────────
# AppID is an integer from the ZEGO Console. Server secret is the 32-byte
# hex string shown in Console → AppID → Basic Info → Server Secret.
# The token endpoint (POST /api/zego/token) uses these to sign Token04 JWTs.
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# ── Vault Pro (AES-256-GCM stream key storage) ──────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: rotate this if ever exposed. Changing it invalidates all stored keys.
VAULT_SECRET=

# ── RTMP Fanout Ingest ───────────────────────────────────────────────────────
# Where FFmpeg reads the SFU's RTMP output for fanout to platforms.
# Defaults to localhost:1935 if not set.
RTMP_INGEST_HOST=localhost
RTMP_INGEST_PORT=1935

# ── Supabase (PostgreSQL) ─────────────────────────────────────────────────────
# REST API (used by login.js for Supabase Auth)
SUPABASE_URL=https://<project-ref>.supabase.co
# Anon/public key — also accepted as SUPABASE_KEY (legacy name)
SUPABASE_ANON_KEY=
# Service-role key — used by admin routes (users, sounds, media, vod, directPay, rewards)
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string — Supabase dashboard → Project Settings → Database → URI
# Use port 6543 (pooler/pgbouncer) for production, 5432 for direct connection.
# postgresql://postgres.[ref]:[password]@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:[password]@db.<project-ref>.supabase.co:5432/postgres

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@seewhylive.online

# ── Stripe subscription price IDs ───────────────────────────────────────────
# From Stripe Dashboard → Products. Required for subscription plan endpoints.
STRIPE_PRICE_PLAN_CREATOR=price_...
STRIPE_PRICE_PLAN_PRO=price_...
STRIPE_PRICE_PLAN_STUDIO=price_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
# From resend.com — used for transactional emails (invites, receipts, etc.)
RESEND_API_KEY=re_...

# ── AI features ──────────────────────────────────────────────────────────────
# At least one of these is required for AURA AI and TTS features.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-3-5-sonnet

# ── Encryption (stream key backup, etc.) ─────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── n8n automation webhook ───────────────────────────────────────────────────
# Secret shared with your n8n instance. Optional — only needed for n8n flows.
# N8N_SECRET=

# ── Invite-code gating (optional) ────────────────────────────────────────────
# Comma-separated list of valid invite codes for early access gating.
# INVITE_CODES=CODE1,CODE2,CODE3

# ── TURN server URLs (optional fallback) ─────────────────────────────────────
# If you run a separate TURN server in addition to the HMAC-generated credentials.
# TURN_URL=turn:your-turn-server.com:3478
# TURNS_URL=turns:your-turn-server.com:5349

# ── FUEL currency packages (optional override) ────────────────────────────────
# JSON array of [cents, fuel] pairs. Defaults are built into the server.
# FUEL_PACKAGES=[[499,500],[999,1100],[1999,2500],[4999,7000]]
