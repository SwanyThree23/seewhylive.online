# SeeWhy LIVE — server environment variables
# Copy to .env and fill in real values before starting the server.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=/opt/seewhy/data/seewhy.db

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── CORS / frontend ──────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://seewhylive.online

# ── mediasoup SFU ────────────────────────────────────────────────────────────
# The public IP address of this VPS, announced to WebRTC clients.
# Defaults to 2.24.194.112 if not set.
MEDIASOUP_ANNOUNCED_IP=2.24.194.112

# ── TURN server ──────────────────────────────────────────────────────────────
# Secret used to generate HMAC-SHA256 TURN credentials (5-min TTL).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURN_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
