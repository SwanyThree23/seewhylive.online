# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/seewhy_live?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Apple OAuth ───────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="seewhy-live-media"
AWS_CLOUDFRONT_DOMAIN="cdn.seewhylive.online"

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@seewhylive.online"

# ── Media server (IVS or Mux) ─────────────────────────────────────────────────
IVS_ACCESS_KEY_ID=""
IVS_SECRET_ACCESS_KEY=""
IVS_CHANNEL_ARN=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
NEXT_PUBLIC_SENTRY_DSN=""
