# SeeWhy LIVE v33.0 — Frontend Environment
# Copy to .env before running vite build

# Socket.io + API server URL (preferred alias)
VITE_SERVER_URL=https://srv1581658.hstgr.cloud:3001
# Legacy alias — both are checked; VITE_SERVER_URL takes precedence
VITE_SOCKET_URL=https://srv1581658.hstgr.cloud:3001

# Stripe publishable key (safe to expose in frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# ── ZEGOCLOUD SFU (LiveStage WebRTC) ─────────────────────────────────────────
# Same AppID integer as server ZEGO_APP_ID. Safe to expose in frontend.
VITE_ZEGO_APP_ID=
# ZEGO server URL from Console → AppID → Basic Info → Server URL
# Example: wss://webliveroom12345678-api.zego.im/ws
VITE_ZEGO_SERVER=
